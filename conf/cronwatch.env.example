# /etc/cron-watchdog/cronwatch.env
# Environment configuration file for cron-watchdog
#
# When placed at /etc/cron-watchdog/cronwatch.env or /etc/default/cronwatch,
# cronwatch will automatically source this file on each execution.

# AWS SNS Topic ARN for publishing alert notifications.
# Leave empty to disable SNS alerting and log to syslog only.
#
# Example:
# CRONWATCH_SNS_TOPIC_ARN="arn:aws:sns:ap-south-1:123456789012:cron-watchdog-alerts"
CRONWATCH_SNS_TOPIC_ARN=""

# AWS Region for SNS publishing (defaults to ap-south-1)
AWS_REGION="ap-south-1"

# Directory path overrides (optional; defaults shown)
# CRONWATCH_LOG_DIR="/var/log/cron-watchdog"
# CRONWATCH_STATE_DIR="/var/lib/cron-watchdog"
# CRONWATCH_CONFIG_DIR="/etc/cron-watchdog"

