#!/usr/bin/env bash
#
# cronwatch - Detect silent cron job failures on Linux
#
# A lightweight, pure-Bash tool built for Linux production environments.
# Wraps cron jobs, tracks execution metrics, maintains per-job heartbeats,
# detects silent failures, and diagnoses host misconfigurations.
#

set -euo pipefail

VERSION="1.0.0"

# Defaults - can be overridden via environment variables for testing or custom paths
CRONWATCH_LOG_DIR="${CRONWATCH_LOG_DIR:-/var/log/cron-watchdog}"
CRONWATCH_LOG_FILE="${CRONWATCH_LOG_FILE:-${CRONWATCH_LOG_DIR}/jobs.log}"
CRONWATCH_STATE_DIR="${CRONWATCH_STATE_DIR:-/var/lib/cron-watchdog}"
CRONWATCH_HEARTBEAT_DIR="${CRONWATCH_HEARTBEAT_DIR:-${CRONWATCH_STATE_DIR}/heartbeats}"
CRONWATCH_CONFIG_DIR="${CRONWATCH_CONFIG_DIR:-/etc/cron-watchdog}"
CRONWATCH_CONFIG_FILE="${CRONWATCH_CONFIG_FILE:-${CRONWATCH_CONFIG_DIR}/jobs.conf}"
CRONWATCH_SNS_TOPIC_ARN="${CRONWATCH_SNS_TOPIC_ARN:-}"

# Helper: escape strings for pure-bash JSON serialization
json_escape() {
    local s="${1:-}"
    # Escape backslashes first to prevent double-escaping subsequent characters
    s="${s//\\/\\\\}"
    # Escape double quotes
    s="${s//\"/\\\"}"
    # Escape control characters: newline, carriage return, tab
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Helper: send alert via syslog (logger) and optionally AWS SNS (Stage 4)
send_alert() {
    local job_name="$1"
    local alert_type="$2"
    local message="$3"
    local details="${4:-}"

    local log_msg="CRITICAL: [cronwatch] Job '${job_name}' alert ${alert_type}: ${message}"
    if [[ -n "$details" ]]; then
        log_msg="${log_msg} | Details: ${details}"
    fi

    # Always log via logger (syslog / journald)
    if command -v logger >/dev/null 2>&1; then
        logger -t cronwatch -p user.err "$log_msg" 2>/dev/null || true
    fi

    # AWS SNS dispatch will be wired in Stage 4
    if [[ -n "$CRONWATCH_SNS_TOPIC_ARN" ]] && command -v aws >/dev/null 2>&1; then
        local sns_subject="[cronwatch alert] ${job_name}: ${alert_type}"
        local sns_body="Host: $(hostname 2>/dev/null || echo 'unknown')
Job: ${job_name}
Alert: ${alert_type}
Message: ${message}
Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")

${details}"
        aws sns publish \
            --topic-arn "$CRONWATCH_SNS_TOPIC_ARN" \
            --subject "$sns_subject" \
            --message "$sns_body" >/dev/null 2>&1 || true
    fi
}

# ==============================================================================
# Subcommand: run
# Usage: cronwatch run <job-name> [--timeout N] -- <command...>
# ==============================================================================
cmd_run() {
    local job_name=""
    local timeout_secs=""
    local cmd=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --timeout)
                if [[ $# -lt 2 ]]; then
                    echo "cronwatch: error: --timeout requires an integer argument (seconds)" >&2
                    return 2
                fi
                timeout_secs="$2"
                shift 2
                ;;
            --)
                shift
                cmd=("$@")
                break
                ;;
            -*)
                echo "cronwatch: error: unknown option for run: $1" >&2
                return 2
                ;;
            *)
                if [[ -z "$job_name" ]]; then
                    job_name="$1"
                    shift
                else
                    echo "cronwatch: error: unexpected argument '$1'. Command must be preceded by '--'." >&2
                    return 2
                fi
                ;;
        esac
    done

    # Validation
    if [[ -z "$job_name" ]]; then
        echo "cronwatch: error: missing job name" >&2
        echo "Usage: cronwatch run <job-name> [--timeout N] -- <command...>" >&2
        return 2
    fi

    if ! [[ "$job_name" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        echo "cronwatch: error: invalid job name '$job_name'. Must contain only alphanumeric, dash, dot, or underscore." >&2
        return 2
    fi

    if [[ ${#cmd[@]} -eq 0 ]]; then
        echo "cronwatch: error: no command specified to execute" >&2
        echo "Usage: cronwatch run <job-name> [--timeout N] -- <command...>" >&2
        return 2
    fi

    if [[ -n "$timeout_secs" ]]; then
        if ! [[ "$timeout_secs" =~ ^[0-9]+$ ]] || [[ "$timeout_secs" -le 0 ]]; then
            echo "cronwatch: error: --timeout must be a positive integer" >&2
            return 2
        fi
    fi

    # Record start time
    local start_iso
    local start_epoch
    local end_iso
    local end_epoch
    local duration
    local exit_code=0
    local status="SUCCESS"

    start_iso=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    start_epoch=$(date +%s)

    # Secure temp file for stderr capture
    local stderr_tmp
    stderr_tmp=$(mktemp "${TMPDIR:-/tmp}/cronwatch-stderr.XXXXXX" 2>/dev/null || echo "/tmp/cronwatch-stderr.$$.$RANDOM")
    touch "$stderr_tmp" 2>/dev/null || true

    cleanup() {
        if [[ -n "${stderr_tmp:-}" && -f "$stderr_tmp" ]]; then
            rm -f "$stderr_tmp"
        fi
    }
    trap cleanup EXIT INT TERM

    # Execute wrapped command
    if [[ -n "$timeout_secs" ]]; then
        if command -v timeout >/dev/null 2>&1; then
            # Use -k 10 to send SIGKILL 10s after SIGTERM if the process hangs
            timeout -k 10 "${timeout_secs}" "${cmd[@]}" 2>"$stderr_tmp" || exit_code=$?
            if [[ "$exit_code" -eq 124 || "$exit_code" -eq 137 ]]; then
                status="TIMED_OUT"
            elif [[ "$exit_code" -ne 0 ]]; then
                status="FAILED"
            fi
        else
            echo "cronwatch: warning: 'timeout' utility not found; running command without timeout" >&2
            "${cmd[@]}" 2>"$stderr_tmp" || exit_code=$?
            if [[ "$exit_code" -ne 0 ]]; then
                status="FAILED"
            fi
        fi
    else
        "${cmd[@]}" 2>"$stderr_tmp" || exit_code=$?
        if [[ "$exit_code" -ne 0 ]]; then
            status="FAILED"
        fi
    fi

    # Record end time & duration
    end_iso=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    end_epoch=$(date +%s)
    duration=$(( end_epoch - start_epoch ))
    if [[ "$duration" -lt 0 ]]; then
        duration=0
    fi

    # Echo original stderr back to stream so caller/sysadmin sees it as normal
    if [[ -s "$stderr_tmp" ]]; then
        cat "$stderr_tmp" >&2
    fi

    # Capture last 20 lines of stderr for alerting & logging
    local stderr_tail=""
    if [[ -f "$stderr_tmp" ]]; then
        stderr_tail=$(tail -n 20 "$stderr_tmp")
    fi

    # On success: update per-job heartbeat file atomically
    if [[ "$status" == "SUCCESS" ]]; then
        if ! mkdir -p "$CRONWATCH_HEARTBEAT_DIR" 2>/dev/null; then
            echo "cronwatch: warning: cannot create heartbeat directory: $CRONWATCH_HEARTBEAT_DIR" >&2
        else
            local heartbeat_file="${CRONWATCH_HEARTBEAT_DIR}/${job_name}"
            local heartbeat_tmp="${heartbeat_file}.tmp.$$"
            cat <<EOF > "$heartbeat_tmp" 2>/dev/null || true
JOB_NAME=${job_name}
LAST_SUCCESS_ISO=${end_iso}
LAST_SUCCESS_EPOCH=${end_epoch}
LAST_DURATION_SECONDS=${duration}
EOF
            if [[ -f "$heartbeat_tmp" ]]; then
                mv -f "$heartbeat_tmp" "$heartbeat_file" 2>/dev/null || touch "$heartbeat_file" 2>/dev/null || true
            else
                touch "$heartbeat_file" 2>/dev/null || true
            fi
        fi
    fi

    # Log execution result to JSON-lines log file
    if ! mkdir -p "$CRONWATCH_LOG_DIR" 2>/dev/null; then
        echo "cronwatch: error: cannot create log directory: $CRONWATCH_LOG_DIR" >&2
    fi

    local log_entry=""
    if command -v jq >/dev/null 2>&1; then
        log_entry=$(jq -c -n \
            --arg ts "$end_iso" \
            --arg job "$job_name" \
            --arg start "$start_iso" \
            --arg end "$end_iso" \
            --argjson dur "$duration" \
            --argjson code "$exit_code" \
            --arg status "$status" \
            --arg stderr "$stderr_tail" \
            '{timestamp: $ts, job_name: $job, start_time: $start, end_time: $end, duration_seconds: $dur, exit_code: $code, status: $status, stderr_tail: $stderr}')
    else
        local escaped_job
        local escaped_stderr
        escaped_job=$(json_escape "$job_name")
        escaped_stderr=$(json_escape "$stderr_tail")
        log_entry=$(printf '{"timestamp":"%s","job_name":"%s","start_time":"%s","end_time":"%s","duration_seconds":%d,"exit_code":%d,"status":"%s","stderr_tail":"%s"}' \
            "$end_iso" "$escaped_job" "$start_iso" "$end_iso" "$duration" "$exit_code" "$status" "$escaped_stderr")
    fi

    if ! printf '%s\n' "$log_entry" >> "$CRONWATCH_LOG_FILE" 2>/dev/null; then
        echo "cronwatch: error: failed to write log entry to $CRONWATCH_LOG_FILE" >&2
    fi

    # Propagate exit code to preserve normal cron notification semantics
    return "$exit_code"
}

# ==============================================================================
# Subcommand: check
# Usage: cronwatch check [--quiet]
# ==============================================================================
cmd_check() {
    local quiet_mode=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quiet)
                quiet_mode=true
                shift
                ;;
            -h|--help)
                echo "Usage: cronwatch check [--quiet]"
                echo "Inspect configured jobs in $CRONWATCH_CONFIG_FILE and report failures, missed runs, or slow jobs."
                return 0
                ;;
            *)
                echo "cronwatch: error: unknown option for check: $1" >&2
                return 2
                ;;
        esac
    done

    # Check configuration existence
    if [[ ! -f "$CRONWATCH_CONFIG_FILE" ]]; then
        echo "cronwatch: error: configuration file not found: $CRONWATCH_CONFIG_FILE" >&2
        echo "cronwatch: hint: create $CRONWATCH_CONFIG_FILE with format '<job-name> <max_age_minutes> [max_duration_seconds]'" >&2
        return 2
    fi

    local total_checked=0
    local total_failed=0
    local total_warnings=0
    local now_epoch
    now_epoch=$(date +%s)

    local report_lines=()

    # Read jobs configuration line by line
    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        # Strip comments and trim leading/trailing whitespace
        local clean_line="${raw_line%%#*}"
        clean_line=$(echo "$clean_line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

        [[ -z "$clean_line" ]] && continue

        # Parse line: job_name, max_age_min, optional max_duration_sec
        local job_name=""
        local max_age_min=""
        local max_duration_sec=""
        read -r job_name max_age_min max_duration_sec _ <<< "$clean_line"

        if [[ -z "$job_name" || -z "$max_age_min" ]]; then
            echo "cronwatch: warning: invalid config line ignored: '$raw_line'" >&2
            continue
        fi

        if ! [[ "$max_age_min" =~ ^[0-9]+$ ]] || [[ "$max_age_min" -le 0 ]]; then
            echo "cronwatch: warning: invalid max_age '$max_age_min' for job '$job_name'" >&2
            continue
        fi

        total_checked=$(( total_checked + 1 ))
        local job_failed=false
        local job_warning=false
        local job_issues=()
        local job_details=()

        # -------------------------------------------------------------
        # Condition 1: Heartbeat check (missed schedule or never ran)
        # -------------------------------------------------------------
        local heartbeat_file="${CRONWATCH_HEARTBEAT_DIR}/${job_name}"
        local last_success_epoch=""
        local last_success_iso=""

        if [[ -f "$heartbeat_file" ]]; then
            # Extract recorded timestamp from heartbeat file
            if grep -q "^LAST_SUCCESS_EPOCH=" "$heartbeat_file" 2>/dev/null; then
                last_success_epoch=$(grep "^LAST_SUCCESS_EPOCH=" "$heartbeat_file" | head -n 1 | cut -d'=' -f2)
            fi
            if grep -q "^LAST_SUCCESS_ISO=" "$heartbeat_file" 2>/dev/null; then
                last_success_iso=$(grep "^LAST_SUCCESS_ISO=" "$heartbeat_file" | head -n 1 | cut -d'=' -f2)
            fi

            # Fallback to filesystem mtime if epoch wasn't read
            if [[ -z "$last_success_epoch" || ! "$last_success_epoch" =~ ^[0-9]+$ ]]; then
                last_success_epoch=$(stat -c %Y "$heartbeat_file" 2>/dev/null || stat -f %m "$heartbeat_file" 2>/dev/null || echo "$now_epoch")
            fi

            local age_seconds=$(( now_epoch - last_success_epoch ))
            [[ "$age_seconds" -lt 0 ]] && age_seconds=0
            local age_minutes=$(( age_seconds / 60 ))
            local max_age_seconds=$(( max_age_min * 60 ))

            if [[ "$age_seconds" -gt "$max_age_seconds" ]]; then
                job_failed=true
                local issue_msg="MISSED_HEARTBEAT (last success ${age_minutes}m ago at ${last_success_iso:-unknown}, max allowed ${max_age_min}m)"
                job_issues+=("$issue_msg")
                send_alert "$job_name" "MISSED_HEARTBEAT" "$issue_msg" "Heartbeat file: $heartbeat_file"
            fi
        else
            # Heartbeat file does not exist
            job_failed=true
            local issue_msg="NEVER_RAN (no heartbeat file found at ${heartbeat_file})"
            job_issues+=("$issue_msg")
            send_alert "$job_name" "NEVER_RAN" "$issue_msg" "Heartbeat file missing"
        fi

        # -------------------------------------------------------------
        # Condition 2: Latest execution check (non-zero or timed out)
        # -------------------------------------------------------------
        local latest_entry=""
        if [[ -f "$CRONWATCH_LOG_FILE" ]]; then
            latest_entry=$(grep "\"job_name\":\"${job_name}\"" "$CRONWATCH_LOG_FILE" 2>/dev/null | tail -n 1 || true)
        fi

        local latest_duration=0
        local latest_status=""
        local latest_exit_code=0
        local latest_time=""
        local latest_stderr=""

        if [[ -n "$latest_entry" ]]; then
            if [[ "$latest_entry" =~ \"status\":\"([^\"]*)\" ]]; then
                latest_status="${BASH_REMATCH[1]}"
            fi
            if [[ "$latest_entry" =~ \"exit_code\":([0-9]+) ]]; then
                latest_exit_code="${BASH_REMATCH[1]}"
            fi
            if [[ "$latest_entry" =~ \"duration_seconds\":([0-9]+) ]]; then
                latest_duration="${BASH_REMATCH[1]}"
            fi
            if [[ "$latest_entry" =~ \"timestamp\":\"([^\"]*)\" ]]; then
                latest_time="${BASH_REMATCH[1]}"
            fi

            # Extract stderr tail if present
            if command -v jq >/dev/null 2>&1; then
                latest_stderr=$(echo "$latest_entry" | jq -r '.stderr_tail // empty' 2>/dev/null || true)
            else
                if [[ "$latest_entry" =~ \"stderr_tail\":\"(.*)\"\} ]]; then
                    latest_stderr="${BASH_REMATCH[1]}"
                fi
            fi

            if [[ "$latest_status" == "FAILED" ]]; then
                job_failed=true
                local fail_msg="EXIT_NONZERO (exit code ${latest_exit_code} at ${latest_time})"
                job_issues+=("$fail_msg")
                if [[ -n "$latest_stderr" ]]; then
                    job_details+=("stderr: ${latest_stderr}")
                fi
                send_alert "$job_name" "EXIT_NONZERO" "$fail_msg" "Stderr tail: ${latest_stderr}"
            elif [[ "$latest_status" == "TIMED_OUT" ]]; then
                job_failed=true
                local timeout_msg="TIMED_OUT (killed after ${latest_duration}s at ${latest_time})"
                job_issues+=("$timeout_msg")
                if [[ -n "$latest_stderr" ]]; then
                    job_details+=("stderr: ${latest_stderr}")
                fi
                send_alert "$job_name" "TIMED_OUT" "$timeout_msg" "Stderr tail: ${latest_stderr}"
            fi

            # -------------------------------------------------------------
            # Condition 3: Duration check (exceeded limit or anomaly)
            # -------------------------------------------------------------
            # Check A: Explicit max_duration_sec configured in jobs.conf
            if [[ -n "$max_duration_sec" && "$max_duration_sec" =~ ^[0-9]+$ && "$max_duration_sec" -gt 0 ]]; then
                if [[ "$latest_duration" -gt "$max_duration_sec" ]]; then
                    job_warning=true
                    local dur_msg="DURATION_EXCEEDED (last run took ${latest_duration}s, configured max ${max_duration_sec}s)"
                    job_issues+=("$dur_msg")
                    send_alert "$job_name" "DURATION_EXCEEDED" "$dur_msg" ""
                fi
            fi

            # Check B: Runtime anomaly vs historical successful runs (>3x average, min 15s)
            local past_durations=()
            while read -r d; do
                [[ -n "$d" && "$d" =~ ^[0-9]+$ ]] && past_durations+=("$d")
            done < <(grep "\"job_name\":\"${job_name}\"" "$CRONWATCH_LOG_FILE" 2>/dev/null | grep '"status":"SUCCESS"' | tail -n 10 | sed -n 's/.*"duration_seconds":\([0-9]*\).*/\1/p' || true)

            # Need at least 3 historical successful runs to compute meaningful baseline
            if [[ ${#past_durations[@]} -ge 3 ]]; then
                local dur_sum=0
                for d in "${past_durations[@]}"; do
                    dur_sum=$(( dur_sum + d ))
                done
                local dur_avg=$(( dur_sum / ${#past_durations[@]} ))
                if [[ "$dur_avg" -gt 0 && "$latest_duration" -ge $(( dur_avg * 3 )) && "$latest_duration" -ge 15 ]]; then
                    job_warning=true
                    local anomaly_msg="DURATION_ANOMALY (last run took ${latest_duration}s, baseline average is ${dur_avg}s [>3x])"
                    job_issues+=("$anomaly_msg")
                    send_alert "$job_name" "DURATION_ANOMALY" "$anomaly_msg" "Historical samples: ${past_durations[*]}"
                fi
            fi
        fi

        # Collate reporting state for this job
        if [[ "$job_failed" == true ]]; then
            total_failed=$(( total_failed + 1 ))
            report_lines+=("[FAIL] ${job_name}: $(IFS='; '; echo "${job_issues[*]}")")
            for det in "${job_details[@]}"; do
                report_lines+=("       ${det}")
            done
        elif [[ "$job_warning" == true ]]; then
            total_warnings=$(( total_warnings + 1 ))
            report_lines+=("[WARN] ${job_name}: $(IFS='; '; echo "${job_issues[*]}")")
        else
            local succ_age="unknown"
            if [[ -n "$last_success_epoch" ]]; then
                local ok_age_sec=$(( now_epoch - last_success_epoch ))
                succ_age="$(( ok_age_sec / 60 ))m"
            fi
            report_lines+=("[OK]   ${job_name}: healthy (last success ${succ_age} ago, last duration ${latest_duration}s)")
        fi

    done < "$CRONWATCH_CONFIG_FILE"

    # In quiet mode, only output if failures or warnings exist
    if [[ "$quiet_mode" == true ]]; then
        if [[ "$total_failed" -gt 0 || "$total_warnings" -gt 0 ]]; then
            printf '%s\n' "${report_lines[@]}"
            echo "Summary: ${total_checked} checked, ${total_failed} failed, ${total_warnings} warnings."
        fi
    else
        printf '%s\n' "${report_lines[@]}"
        echo "Summary: ${total_checked} checked, ${total_failed} failed, ${total_warnings} warnings."
    fi

    # Exit code: 1 if any job failed, 0 if healthy (or only warnings)
    if [[ "$total_failed" -gt 0 ]]; then
        return 1
    fi
    return 0
}

# ==============================================================================
# Subcommand: doctor
# Usage: cronwatch doctor [optional-scripts...]
# ==============================================================================

# Doctor Check 1: Cron service status (systemctl / service / pgrep)
doctor_check_service() {
    local svc_active=false
    local svc_name=""

    if command -v systemctl >/dev/null 2>&1; then
        for s in cron crond; do
            if systemctl is-active --quiet "$s" 2>/dev/null; then
                svc_active=true
                svc_name="$s"
                break
            fi
        done
    fi

    # Fallback to service command or pgrep
    if [[ "$svc_active" == false ]]; then
        if command -v service >/dev/null 2>&1; then
            if service cron status >/dev/null 2>&1; then
                svc_active=true
                svc_name="cron"
            elif service crond status >/dev/null 2>&1; then
                svc_active=true
                svc_name="crond"
            fi
        fi
        if [[ "$svc_active" == false ]]; then
            if pgrep -x cron >/dev/null 2>&1; then
                svc_active=true
                svc_name="cron (process)"
            elif pgrep -x crond >/dev/null 2>&1; then
                svc_active=true
                svc_name="crond (process)"
            fi
        fi
    fi

    if [[ "$svc_active" == true ]]; then
        echo "[PASS] Cron Service: Active and running (${svc_name})"
        return 0
    else
        echo "[FAIL] Cron Service: Cron daemon is stopped or not active"
        echo "       Hint: Run 'sudo systemctl enable --now cron' (or 'sudo systemctl enable --now crond') to start the service."
        return 1
    fi
}

# Doctor Check 2: Recent cron entries in journalctl / syslog
doctor_check_logs() {
    local entries_found=0
    local log_source=""

    # Try journalctl first
    if command -v journalctl >/dev/null 2>&1; then
        local jcount
        jcount=$(journalctl -u cron -u crond --since "24 hours ago" --no-pager -n 50 2>/dev/null | grep -c -i "cron" || true)
        if [[ "$jcount" -gt 0 ]]; then
            entries_found="$jcount"
            log_source="journalctl"
        fi
    fi

    # Try syslog / cron log files
    if [[ "$entries_found" -eq 0 ]]; then
        for lf in /var/log/syslog /var/log/cron /var/log/messages; do
            if [[ -r "$lf" ]]; then
                local fcount
                fcount=$(grep -c -E "(CRON\[|crond\[)" "$lf" 2>/dev/null || true)
                if [[ "$fcount" -gt 0 ]]; then
                    entries_found="$fcount"
                    log_source="$lf"
                    break
                fi
            fi
        done
    fi

    if [[ "$entries_found" -gt 0 ]]; then
        echo "[PASS] Syslog/Journal: Cron execution events detected in ${log_source} (${entries_found} recent entries)"
        return 0
    else
        echo "[WARN] Syslog/Journal: No recent cron events found in system logs"
        echo "       Hint: Verify scheduled jobs exist with 'crontab -l' and inspect /var/log/syslog or 'journalctl -u cron'."
        return 0
    fi
}

# Doctor Check 3: Crontab trailing newline check
doctor_check_trailing_newline() {
    local missing=()
    local files_to_check=()

    # System crontabs
    [[ -f /etc/crontab ]] && files_to_check+=(/etc/crontab)
    if [[ -d /etc/cron.d ]]; then
        for f in /etc/cron.d/*; do
            [[ -f "$f" ]] && files_to_check+=("$f")
        done
    fi

    for cf in "${files_to_check[@]}"; do
        if [[ -r "$cf" && -s "$cf" ]]; then
            local last_char
            last_char=$(tail -c 1 "$cf" 2>/dev/null || true)
            if [[ "$last_char" != $'\n' ]]; then
                missing+=("$cf")
            fi
        fi
    done

    # Check user crontab if available
    if command -v crontab >/dev/null 2>&1; then
        local user_cron
        user_cron=$(crontab -l 2>/dev/null || true)
        if [[ -n "$user_cron" ]]; then
            local last_cron_char="${user_cron: -1}"
            if [[ "$last_cron_char" != $'\n' ]]; then
                missing+=("user crontab (crontab -l)")
            fi
        fi
    fi

    if [[ ${#missing[@]} -eq 0 ]]; then
        echo "[PASS] Crontab Newline: Trailing newline present in crontab files"
        return 0
    else
        echo "[FAIL] Crontab Newline: File missing trailing newline (Vixie cron silently drops the last line!):"
        for m in "${missing[@]}"; do
            echo "       - $m"
        done
        echo "       Hint: Run 'echo \"\" >> <file>' or ensure your text editor inserts a trailing newline."
        return 1
    fi
}

# Doctor Check 4: Windows CRLF line endings (\r\n) in scripts
doctor_check_crlf() {
    local target_scripts=("$@")
    local crlf_found=()

    for s in "${target_scripts[@]}"; do
        if [[ -f "$s" && -r "$s" ]]; then
            if grep -q $'\r' "$s" 2>/dev/null; then
                crlf_found+=("$s")
            fi
        fi
    done

    if [[ ${#crlf_found[@]} -eq 0 ]]; then
        echo "[PASS] Line Endings: No Windows CRLF (\\r\\n) line endings detected in checked scripts"
        return 0
    else
        echo "[FAIL] Line Endings: Windows CRLF (\\r\\n) line endings detected (causes '/bin/bash^M: bad interpreter'):"
        for f in "${crlf_found[@]}"; do
            echo "       - $f"
        done
        echo "       Hint: Run 'sed -i \"s/\\r$//\" <script>' or 'dos2unix <script>' to convert to Unix LF."
        return 1
    fi
}

# Doctor Check 5: Script executable permissions (+x)
doctor_check_executable() {
    local target_scripts=("$@")
    local non_exec=()

    for s in "${target_scripts[@]}"; do
        if [[ -f "$s" ]]; then
            if [[ ! -x "$s" ]]; then
                non_exec+=("$s")
            fi
        fi
    done

    if [[ ${#non_exec[@]} -eq 0 ]]; then
        echo "[PASS] Executable Bit: All checked script files have executable (+x) permissions"
        return 0
    else
        echo "[FAIL] Executable Bit: Script is not marked executable:"
        for f in "${non_exec[@]}"; do
            echo "       - $f"
        done
        echo "       Hint: Run 'chmod +x <script>' so cron can execute it."
        return 1
    fi
}

# Doctor Check 6: Permissions and ownership on files cron runs
doctor_check_permissions() {
    local insecure=()
    local cron_dirs=(/etc/crontab /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly)

    for item in "${cron_dirs[@]}"; do
        if [[ -d "$item" ]]; then
            for f in "$item"/*; do
                [[ -f "$f" ]] || continue
                local owner_uid=""
                owner_uid=$(stat -c %u "$f" 2>/dev/null || stat -f %u "$f" 2>/dev/null || true)
                if [[ -n "$owner_uid" && "$owner_uid" -ne 0 ]]; then
                    insecure+=("$f (owned by UID $owner_uid, must be root/0)")
                fi
                local mode=""
                mode=$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null || true)
                if [[ -n "$mode" ]]; then
                    # Check group or other write bit (2, 3, 6, 7)
                    if [[ "$mode" =~ [2367][0-9]$ || "$mode" =~ [2367]$ ]]; then
                        insecure+=("$f (mode ${mode} is group/world-writable)")
                    fi
                fi
            done
        elif [[ -f "$item" ]]; then
            local mode=""
            mode=$(stat -c %a "$item" 2>/dev/null || stat -f %Lp "$item" 2>/dev/null || true)
            if [[ -n "$mode" && ( "$mode" =~ [2367][0-9]$ || "$mode" =~ [2367]$ ) ]]; then
                insecure+=("$item (mode ${mode} is group/world-writable)")
            fi
        fi
    done

    if [[ ${#insecure[@]} -eq 0 ]]; then
        echo "[PASS] File Permissions: System cron directory files have secure ownership & permissions"
        return 0
    else
        echo "[FAIL] File Permissions: Cron refuses to run files that are not owned by root or are group/world-writable:"
        for f in "${insecure[@]}"; do
            echo "       - $f"
        done
        echo "       Hint: Run 'sudo chown root:root <file> && sudo chmod 644 <file>'. Cron rejects 'BAD FILE MODE'."
        return 1
    fi
}

# Doctor Check 7: PATH & environment differences
doctor_check_path_env() {
    local issues=()
    local cron_default_path="/usr/bin:/bin"
    local common_tools=(aws jq logger timeout curl python3)

    for tool in "${common_tools[@]}"; do
        if command -v "$tool" >/dev/null 2>&1; then
            local tool_path
            tool_path=$(command -v "$tool")
            if [[ "$tool_path" != /usr/bin/* && "$tool_path" != /bin/* ]]; then
                issues+=("'$tool' is at $tool_path (outside cron default PATH: $cron_default_path)")
            fi
        fi
    done

    if [[ ${#issues[@]} -eq 0 ]]; then
        echo "[PASS] PATH & Environment: Standard tools are accessible in cron's default search PATH"
        return 0
    else
        echo "[WARN] PATH & Environment: Tools located outside cron's default search PATH ($cron_default_path):"
        for iss in "${issues[@]}"; do
            echo "       - $iss"
        done
        echo "       Hint: Add 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' at the top of crontab, or use absolute paths."
        return 0
    fi
}

cmd_doctor() {
    echo "============================================================"
    echo "          cronwatch doctor - Cron Health Diagnostics        "
    echo "============================================================"

    local pass_count=0
    local fail_count=0
    local warn_count=0

    # Collect target scripts to check
    local scripts_to_check=()
    if [[ $# -gt 0 ]]; then
        scripts_to_check=("$@")
    else
        # Auto-discover scripts from cron directories and demo folder
        for d in /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly demo; do
            if [[ -d "$d" ]]; then
                for f in "$d"/*; do
                    [[ -f "$f" ]] && scripts_to_check+=("$f")
                done
            fi
        done
    fi

    # Run Check 1: Cron Service
    if doctor_check_service; then
        pass_count=$(( pass_count + 1 ))
    else
        fail_count=$(( fail_count + 1 ))
    fi

    # Run Check 2: Syslog / Journal Activity
    if doctor_check_logs; then
        pass_count=$(( pass_count + 1 ))
    fi

    # Run Check 3: Crontab Trailing Newline
    if doctor_check_trailing_newline; then
        pass_count=$(( pass_count + 1 ))
    else
        fail_count=$(( fail_count + 1 ))
    fi

    # Run Check 4: CRLF Line Endings
    if doctor_check_crlf "${scripts_to_check[@]}"; then
        pass_count=$(( pass_count + 1 ))
    else
        fail_count=$(( fail_count + 1 ))
    fi

    # Run Check 5: Executable Bit
    if doctor_check_executable "${scripts_to_check[@]}"; then
        pass_count=$(( pass_count + 1 ))
    else
        fail_count=$(( fail_count + 1 ))
    fi

    # Run Check 6: Cron File Permissions
    if doctor_check_permissions; then
        pass_count=$(( pass_count + 1 ))
    else
        fail_count=$(( fail_count + 1 ))
    fi

    # Run Check 7: PATH & Environment Differences
    if doctor_check_path_env; then
        pass_count=$(( pass_count + 1 ))
    fi

    echo "============================================================"
    echo "Diagnostic Summary: ${pass_count} PASS, ${fail_count} FAIL, ${warn_count} WARN"

    if [[ "$fail_count" -gt 0 ]]; then
        echo "Status: Issues detected that could cause silent cron job failures."
        return 1
    else
        echo "Status: System is healthy for cron job execution."
        return 0
    fi
}

usage() {
    cat <<EOF
cronwatch v${VERSION} - Detect silent cron job failures on Linux

Usage:
  cronwatch <command> [arguments...]

Commands:
  run <job-name> [--timeout N] -- <command...>
      Execute a cron command wrapped with monitoring. Records metrics to
      $CRONWATCH_LOG_FILE and updates heartbeat on success.
  check [--quiet]
      Inspect configured jobs in $CRONWATCH_CONFIG_FILE.
      Detects missed schedules, exit errors, timeouts, and slow runs.
  doctor [script...]
      Diagnose common causes of silent cron failure (service status,
      CRLF, permissions, trailing newlines, PATH/env differences).
  version
      Print version information.
  help
      Show this help message.

Environment Variables:
  CRONWATCH_LOG_DIR       Directory for logs (default: /var/log/cron-watchdog)
  CRONWATCH_LOG_FILE      Log file path (default: <CRONWATCH_LOG_DIR>/jobs.log)
  CRONWATCH_STATE_DIR     Directory for state (default: /var/lib/cron-watchdog)
  CRONWATCH_HEARTBEAT_DIR Heartbeats directory (default: <CRONWATCH_STATE_DIR>/heartbeats)
  CRONWATCH_CONFIG_DIR    Configuration directory (default: /etc/cron-watchdog)
  CRONWATCH_CONFIG_FILE   Configuration file path (default: <CRONWATCH_CONFIG_DIR>/jobs.conf)
  CRONWATCH_SNS_TOPIC_ARN AWS SNS Topic ARN for publishing alert notifications
EOF
}

main() {
    if [[ $# -lt 1 ]]; then
        usage
        exit 1
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        run)
            cmd_run "$@"
            exit $?
            ;;
        check)
            cmd_check "$@"
            exit $?
            ;;
        doctor)
            cmd_doctor "$@"
            exit $?
            ;;
        version|--version|-v)
            echo "cronwatch version ${VERSION}"
            exit 0
            ;;
        help|--help|-h)
            usage
            exit 0
            ;;
        *)
            echo "cronwatch: error: unknown command '$subcommand'" >&2
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
